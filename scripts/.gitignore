# Generated by the bug-review skill — do not commit data/artifacts.
# The committed source is the Python scripts, settings, and docs. NOTHING else:
# no pulled Jira data, no analysis/plan JSON, no run ledger, no deliverables.
# The repo-root .gitignore is the broad safety net (by extension); this file adds
# by-name patterns for the specific artifacts a run produces.
#
# COMMITTED FILES:
#   Python scripts: pull_*.py, run_review.py, classify_headless.py,
#     build_deliverables.py, split_plan.py, needs_review.py, lib_run.py,
#     validate_schema.py, write_back.py, add_label.py, create_subtasks.py,
#     make_report_docx.py
#   Configuration: ../.claude/settings.json, ../.claude/headless-settings.json

# Secrets / credentials
.env

# Python bytecode cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Pulled JIRA data (from pull_bugs.py / pull_features.py)
bugs_*.json
features_*.json

# Classification & analysis artifacts
analysis_*.json
plan_*.json
plan_*.auto.json
plan_*.review.json
plan_*.canary_summary.json
plan_*.apply_summary.json
feature_map_*.json
verdicts_*.json

# Classification overrides / issue-creation specs
new_classifications.json
*_bug_*.json
escalation_model_bug.json

# Sub-task creation specs (input to create_subtasks.py, per-parent)
subtasks_*.json

# Intermediate PRD / digest text dumps
_*.txt

# Generated reports (markdown + Word + Excel)
report_*.md
Bug_*.md
NEEDS_REVIEW_*.md
Bug_*.xlsx
Bug_*.docx
*.docx

# Combined multi-release reports
*_Combined.xlsx
combined_analysis.json

# Run ledger and per-run logs — local audit trail, never committed
runs.jsonl
logs/
*.log
