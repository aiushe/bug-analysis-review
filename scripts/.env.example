# Copy to .env and fill in. .env is gitignored — never commit a token.
# Every value here can also be exported in your shell instead.

# --- required ---
# Your Jira Server / Data Center site.
JIRA_BASE_URL=https://jira.example.com
# Personal Access Token: avatar → Profile → Personal Access Tokens → Create token.
JIRA_PAT=paste-your-token-here
# Project key features (PRDs) live in — pull_features.py needs this.
JIRA_FEATURE_PROJECT=PROJ

# --- optional: what to pull ---
# Issue type(s) that represent a feature/PRD in that project (comma-separated).
#JIRA_FEATURE_ISSUETYPES=New Feature Request
# Narrow the bug pull to specific components (comma-separated, exact strings from
# your Jira). Unset = every component on the release.
#JIRA_COMPONENTS=Component A,Component B

# --- optional: what to write back ---
# Issue link type used for bug → feature links. write_back.py lists your site's
# real link types if this one doesn't exist.
#JIRA_LINK_TYPE=Requirement Link
# Display names of the two custom fields; IDs are looked up at runtime by name.
#JIRA_RCA_FIELD_NAME=PM RCA Type
#JIRA_ANALYSIS_FIELD_NAME=PM Analysis
# Numeric ID recorded in the generated plan's meta.field.
#JIRA_RCA_FIELD_ID=customfield_19330
